# .gitignore – Python / Data Science (uv + venv)
# ------------------------------------------------
# WICHTIG: Daten und Modelle NICHT in Git einchecken!
# uv.lock wird NICHT ignoriert – Lockfile gehört in Git!

# ── Daten ──────────────────────────────────────────────────────────────────
# Abweichung vom Standard-Scaffold: dieses Projekt IST ein Archiv. Die
# gesammelten Parquet-Dateien unter data/raw und data/interim gehoeren bewusst
# ins Repo, sie sind das Produkt und kein Nebenprodukt. Jeder Sammel-Lauf
# committet und haelt damit zugleich den GitHub-Actions-Schedule am Leben, der
# sonst nach 60 Tagen ohne Commit automatisch abgeschaltet wuerde.
data/processed/
*.csv
*.xlsx
*.feather
*.h5
*.hdf5

*.parquet
!data/raw/**/*.parquet
!data/interim/*.parquet

# ── Modelle & Artefakte ────────────────────────────────────────────────────
models/
*.pkl
*.joblib
*.pt
*.pth

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/
*.so

# ── Virtuelle Umgebung (uv erstellt .venv/) ────────────────────────────────
.venv/
.venv*/
.env
*.env

# ── Jupyter ────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_metadata

# ── IDE & OS ───────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# ── Public (optional – kommentiere aus, wenn du Public-Artefakte tracken willst) ───
# public/img/
# public/md/
